      "code": "justified_checkpoint = state.previous_justified_checkpoint"
    },
    "inclusion_window": {
      "source": "specs/electra/beacon-chain.md:1646",
      "code": "assert data.target.epoch in (get_previous_epoch(state), get_current_epoch(state))"
    },
    "min_inclusion_delay": {
      "source": "specs/electra/beacon-chain.md:1648",
      "code": "assert data.slot + MIN_ATTESTATION_INCLUSION_DELAY <= state.slot"
    },
    "leak_trigger": {
      "source": "specs/phase0/beacon-chain.md:2033",
      "code": "return get_finality_delay(state) > MIN_EPOCHS_TO_INACTIVITY_PENALTY"
    },
